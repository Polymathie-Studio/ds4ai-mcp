      "status": "planned",
      "note": "A Polymathie plugin (the agent-instruction plus the conformance checks) via a .claude-plugin marketplace, the way p4ai/pt4ai ships."
    },
    "mcp": {
      "status": "future",
      "note": "A cumulative MCP server for the whole suite, once every primitive is done. Out of scope for this pass."
    },
    "designTokens": {
      "status": "review",
      "note": "TEMPER tokens; W3C DTCG alignment to be decided so they can travel to Figma, Style Dictionary, and Tokens Studio."
